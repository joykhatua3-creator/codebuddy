PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional: Upstash Redis (caching and rate limiting). If omitted, automatically falls back to in-memory cache
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Optional: OAuth Sign-In (buttons appear on /login & /register only when configured)
# BACKEND_URL=https://your-backend.onrender.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=
